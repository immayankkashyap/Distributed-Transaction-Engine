# Supabase transaction pooler (port 6543) for the app's Prisma Client.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase direct connection, or session pooler (port 5432), for Prisma migrations.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Use localhost when running npm run dev. Docker Compose overrides this to redis://redis:6379.
REDIS_URL="redis://localhost:6379"
# BOOKING_MODE="baseline"
PORT=3000
