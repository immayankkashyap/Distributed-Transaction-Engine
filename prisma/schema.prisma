generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String           @id @default(uuid())
  name            String
  createdAt       DateTime         @default(now())
  bookings        Booking[]
  idempotencyKeys IdempotencyKey[]
}

model Seat {
  id        String   @id @default(uuid())
  label     String   @unique // e.g. "A1", "Row-5-Seat-12"
  booking   Booking?
  createdAt DateTime @default(now())
}

model Booking {
  id        String   @id @default(uuid())
  userId    String
  seatId    String   @unique // Structural guarantee against double-booking.
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  seat      Seat     @relation(fields: [seatId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}

model IdempotencyKey {
  id         String   @id @default(uuid())
  userId     String
  key        String // Client-sent Idempotency-Key header value.
  seatId     String
  response   Json // Stored response payload for replay.
  statusCode Int
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key], map: "IdempotencyKey_userId_key_key")
}
